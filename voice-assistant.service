[Unit]
Description=Голосовой ассистент (Whisper + Ollama)
PartOf=graphical-session.target
After=graphical-session.target

[Service]
ExecStart=%h/voice-assistant/.venv/bin/python %h/voice-assistant/assistant.py daemon
Environment=PYTHONUNBUFFERED=1
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
